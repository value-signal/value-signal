# https://opendart.fss.or.kr 에서 발급
DART_API_KEY=

# LLM 제공사를 정한 뒤 채
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# 저장된 답이 없는 질문의 하루 LLM 호출 상한
QA_DAILY_LIMIT=15

# Neon PostgreSQL. Vercel에서는 연결 시 자동으로 설정된다
DATABASE_URL=

# 이메일 알림
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
# 하루 메일 발송 상한
ALERT_DAILY_LIMIT=100
# 예약 작업 인증값. openssl rand -hex 32 로 만든다
CRON_SECRET=
# 로컬에서만 설정한다. 배포 환경은 Vercel 값을 쓴다
SITE_URL=
